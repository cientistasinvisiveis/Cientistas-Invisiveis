<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cientistas Invisiveis</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="style/biografia.css">
    <link rel="stylesheet" href="style/caracteristicas-base.css">
</head>

<body>
    <header class="sticky-top">
        <nav class="bg-titulo navbar fundo-header px-1 px-sm-2">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">

                <div class="start d-flex align-items-center">
                    <button class="navbar-toggler me-3 border-0" type="button" data-bs-toggle="offcanvas"
                        data-bs-target="#offcanvas" aria-controls="offcanvas" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <a class="navbar-brand d-flex align-items-center me-0" href="/">
                        <img class="logo-img" src="/img/header/logo.png" alt="Logo Cientistas Invisíveis">
                        <h1 class="titulo">Cientistas Invisiveis</h1>
                    </a>
                </div>

                <div class="grupos-minoritarios d-flex align-items-center">

                    <div class="minoria">
                        <a href="/minoria?nome=LGBTQIAPN%2B">
                            <img src="/img/header/LGBT.png" alt="LGBT">
                        </a>
                    </div>

                    <div class="minoria">
                        <a href="/minoria?nome=Mulheres (Feminismo)">
                            <img src="/img/header/Feminismo.png" alt="Feminismo">
                        </a>
                    </div>

                    <div class="minoria">
                        <a href="/minoria?nome=Pessoas com Deficiência (PCD)">
                            <img src="/img/header/MovimentoPCD.png" alt="Movimento PCD">
                        </a>
                    </div>

                    <div class="minoria">
                        <a href="/minoria?nome=Pessoas Pretas, Pardas e Indígenas (PPI)">
                            <img src="/img/header/MovimentoNegro.png" alt="Movimento Negro">
                        </a>
                    </div>

                </div>

            </div>
        </nav>
    </header>

    <main>
        <div class="conteudo-biografia">
            <% if (pesquisador) { %>
                <div class="card h-100 border-0">
                    <div class="row g-0 h-100">
                        <div class="col-4">
                            <img id="img-pesquisador"
                                src="<%= pesquisador.img || '/img/area-pesquisa/sem-foto-perfil.png' %>"
                                class="img-fluid rounded-start h-100 w-100 object-fit-cover"
                                alt="Foto de <%= pesquisador.nome %>">
                            <div class="fonte-img">
                                <p>Fonte da imagem</p>
                            </div>
                        </div>

                        <div class="col-8">
                            <div class="card-body d-flex flex-column justify-content-center h-100">
                                <h1 id="nome-pesquisador" class="card-title mb-1">
                                    <%= pesquisador.nome %>
                                </h1>
                                <div class="info-pesquisador">
                                    <h2 id="nascimento-morte">
                                        Nascimento e morte: <%= pesquisador.nascimento %> - <%= pesquisador.falecimento
                                                %>
                                    </h2>
                                    <h2 id="origem">
                                        Origem: <%= [pesquisador.cidade, pesquisador.estado,
                                            pesquisador.pais].filter(Boolean).join(', ') || ' Não informada' %>
                                    </h2>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="biografia-pesquisador" class="biografia">
                    <% if (pesquisador.biografia) { %>
                        <%- pesquisador.biografia %>
                            <% } else { %>
                                <p>Biografia não cadastrada para este pesquisador.</p>
                                <% } %>
                </div>
                <% } else { %>
                    <div class="text-center p-5">
                        <h2 class="text-muted">Pesquisador não encontrado.</h2>
                        <a href="/" class="btn btn-outline-primary mt-3">Voltar ao Início</a>
                    </div>
                    <% } %>
        </div>
    </main>
    <footer>© 2025 Cientistas Invisíveis. Todos os direitos reservados. IFSP Campus Jacareí</footer>

    <div class="offcanvas offcanvas-start menu-lateral" tabindex="-1" id="offcanvas" aria-labelledby="offcanvasLabel">
        <div class="offcanvas-header">
            <h5 class="menu-titulo offcanvas-title" id="offcanvasLabel">Cientistas Invisiveis</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="menu-body offcanvas-body">
            <div class="mt-4 pt-3 border-top">
                <div class="form-check form-switch d-flex align-items-center justify-content-between p-0">
                    <label class="form-check-label" for="modoEscuroSwitch">
                        Modo Escuro
                    </label>
                    <input class="form-check-input ms-0" type="checkbox" role="switch" id="modoEscuroSwitch">
                </div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <a href="#  ">Trabalhe conosco</a>
                <p class="desenvolvimento">em desenvolvimento</p>
            </div>


            <div class="mt-4 pt-3 border-top">
                <a href="#  ">Entrar como Administrador</a>
                <p class="desenvolvimento">em desenvolvimento</p>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous">
        </script>
    <script src="/js/darkmode.js"></script>
</body>