<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cientistas Invisiveis</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="style/minoria.css">
    <link rel="stylesheet" href="style/caracteristicas-base.css">

</head>

<body>
    <header class="sticky-top">
        <nav class="bg-titulo navbar fundo-header px-1 px-sm-2">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">

                <div class="start d-flex align-items-center">
                    <button class="navbar-toggler me-3 border-0" type="button" data-bs-toggle="offcanvas"
                        data-bs-target="#offcanvas" aria-controls="offcanvas" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <a class="navbar-brand d-flex align-items-center me-0" href="/">
                        <img class="logo-img" src="/img/header/logo.png" alt="Logo Cientistas Invisíveis">
                        <h1 class="titulo">Cientistas Invisiveis</h1>
                    </a>
                </div>

                <div class="grupos-minoritarios d-flex align-items-center">

                    <div class="minoria">
                        <a href="/minoria?nome=LGBTQIAPN%2B">
                            <img src="/img/header/LGBT.png" alt="LGBT">
                        </a>
                    </div>

                    <div class="minoria">
                        <a href="/minoria?nome=Mulheres (Feminismo)">
                            <img src="/img/header/Feminismo.png" alt="Feminismo">
                        </a>
                    </div>

                    <div class="minoria">
                        <a href="/minoria?nome=Pessoas com Deficiência (PCD)">
                            <img src="/img/header/MovimentoPCD.png" alt="Movimento PCD">
                        </a>
                    </div>

                    <div class="minoria">
                        <a href="/minoria?nome=Pessoas Pretas, Pardas e Indígenas (PPI)">
                            <img src="/img/header/MovimentoNegro.png" alt="Movimento Negro">
                        </a>
                    </div>

                </div>

            </div>
        </nav>
    </header>


    <main>
        <main>
            <div class="conteudo">
                <div class="chamada-cientistas">
                    <h1>Figuras da Comunidade <%= minoria ? minoria.nome : 'X' %>
                    </h1>
                </div>

                <div id="carouselExample" class="carousel slide carrossel-minorico" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        <% if (pesquisadores && pesquisadores.length> 0) { %>
                            <% pesquisadores.forEach((pesquisador, index)=> { %>
                                <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                                    <div class="slide-conteudo">
                                        <div class="slide-imagem">
                                            <img src="<%= pesquisador.foto || 'https://picsum.photos/1920/1080?random=' + (index + 1) %>"
                                                alt="<%= pesquisador.nome %>">
                                        </div>
                                        <div class="cientista-info">
                                            <div class="cabecalho-cientista">
                                                <h2 class="nome-carrossel">
                                                    <%= pesquisador.nome %>
                                                </h2>
                                                <div class="conhecer-cientista">
                                                    <a href="/biografia?id=<%= pesquisador.id %>"
                                                        style="text-decoration: none; color: inherit;">
                                                        <p>!</p>
                                                    </a>
                                                </div>
                                            </div>
                                            <p class="descricao-carrossel">
                                                <%= pesquisador.resumo 
                                                    || 'Sem descrição cadastrada para este cientista.' %>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <div class="carousel-item active">
                                            <div class="slide-conteudo text-center p-5">
                                                <p class="text-muted">Nenhum pesquisador vinculado a esta comunidade no
                                                    momento.</p>
                                            </div>
                                        </div>
                                        <% } %>
                    </div>

                    <button class="carousel-control-prev botao-carrossel" type="button"
                        data-bs-target="#carouselExample" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Anterior</span>
                    </button>
                    <button class="carousel-control-next botao-carrossel" type="button"
                        data-bs-target="#carouselExample" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Próximo</span>
                    </button>
                </div>

                <div class="saiba-mais">
                    <h3>Saiba mais sobre o movimento</h3>
                    <span class="seta-baixo">&#x25BC;</span>
                </div>
            </div>

            <div class="conteudo-movimento">
                <h2 class="titulo-historia-comunidade">História do movimento</h2>

                <div class="historia-comunidade">
                    <% if (minoria && minoria.descricao) { %>
                        <p>
                            <%= minoria.descricao %>
                        </p>
                        <% } else { %>
                            <p class="text-muted">Descrição da comunidade não informada.</p>
                            <% } %>
                </div>

                <div class="row mb-4 conteudo-pesquisadores">
                    <div class="col-12 text-center">
                        <h2 class="titulo-secao-listagem">Pesquisadores</h2>
                    </div>
                </div>

                <div class="row row-cols-1 row-cols-md-2 g-4">
                    <% if (pesquisadores && pesquisadores.length> 0) { %>
                        <% pesquisadores.forEach(pesquisador=> { %>
                            <div class="col pesquisadores">
                                <div class="card h-100 shadow-sm border-0">
                                    <div class="row g-0 h-100">
                                        <div class="col-4">
                                            <img src="<%= pesquisador.foto || '/img/area-pesquisa/sem-foto-perfil.png' %>"
                                                class="img-fluid rounded-start h-100 w-100 object-fit-cover"
                                                alt="Foto de <%= pesquisador.nome %>">
                                        </div>
                                        <div class="col-8">
                                            <div class="card-body d-flex flex-column justify-content-center h-100">
                                                <h5 class="card-title mb-1">
                                                    <%= pesquisador.nome %>
                                                </h5>
                                                <p class="card-text text-muted small mb-2">
                                                    <%= pesquisador.resumo || (pesquisador.biografia ?
                                                        pesquisador.biografia.substring(0, 90) + '...'
                                                        : 'Sem descrição cadastrada.' ) %>
                                                </p>
                                                <a href="/biografia?id=<%= pesquisador.id %>" class="link-biografia">
                                                    Ver biografia &rarr;
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <div class="col-12 text-center">
                                        <p class="text-muted">Nenhum pesquisador listado nesta comunidade.</p>
                                    </div>
                                    <% } %>
                </div>
            </div>
        </main>
    </main>


    <footer>© 2025 Cientistas Invisíveis. Todos os direitos reservados. IFSP Campus Jacareí</footer>
    <div class="offcanvas offcanvas-start menu-lateral" tabindex="-1" id="offcanvas" aria-labelledby="offcanvasLabel">
        <div class="offcanvas-header">
            <h5 class="menu-titulo offcanvas-title" id="offcanvasLabel">Cientistas Invisiveis</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="menu-body offcanvas-body">
            <div class="mt-4 pt-3 border-top">
                <div class="form-check form-switch d-flex align-items-center justify-content-between p-0">
                    <label class="form-check-label" for="modoEscuroSwitch">
                        Modo Escuro
                    </label>
                    <input class="form-check-input ms-0" type="checkbox" role="switch" id="modoEscuroSwitch">
                </div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <a href="#  ">Trabalhe conosco</a>
                <p class="desenvolvimento">em desenvolvimento</p>
            </div>


            <div class="mt-4 pt-3 border-top">
                <a href="#  ">Entrar como Administrador</a>
                <p class="desenvolvimento">em desenvolvimento</p>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous">
        </script>
    <script src="/js/darkmode.js"></script>

</body>